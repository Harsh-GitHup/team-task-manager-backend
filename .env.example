# MySQL Database connection string (e.g. from Railway, PlanetScale, Aiven, or local)
DATABASE_URL=mysql://root:password@host:port/database_name

# Secret used to sign JWT auth tokens
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server port (default 5000 or 8080)
PORT=5000

# Frontend URL(s) for CORS and invite generation (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app
